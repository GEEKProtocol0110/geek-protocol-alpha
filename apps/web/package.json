{
  "name": "@geek/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:brand": "! grep -rnE 'linear-gradient|radial-gradient|conic-gradient|bg-gradient|backdrop-blur|blur-\\[|blur-2xl|blur-3xl' --include='*.tsx' --include='*.css' src || (echo 'BRAND VIOLATION: gradients/blur are banned — use flat fills + hard offset shadows (see globals.css)' && exit 1)",
    "type-check": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "@geek/shared": "*",
    "framer-motion": "^12.42.2",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^5.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

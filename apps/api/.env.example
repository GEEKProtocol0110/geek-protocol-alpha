# DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/geek_protocol?schema=public"

# REDIS
REDIS_URL="redis://localhost:6379"

# SECURITY
SECRET_KEY="replace-with-a-very-long-random-string"
HMAC_SECRET="replace-with-a-very-long-random-hmac-secret"
WALLET_ENCRYPTION_KEY="replace-with-a-32-byte-encryption-key-xxxx"

# CORS
FRONTEND_URL="http://localhost:3000"

# SERVER
PORT=5000
NODE_ENV="development"

# KASPA INTEGRATION
KASPA_NODE_URL="https://testnet-10.kaspa.org"
KASPA_WALLET_ADDRESS="kaspatest:your-platform-wallet-address"
KASPA_RATE_GEEK_PER_KAS=100
TREASURY_PRIVATE_KEY="your-treasury-private-key-here"

# STRIPE
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# DEV FLAGS
DEMO_MODE=true
ENABLE_REWARDS=false
MIN_SCORE_FOR_REWARD=70
REWARD_SATS_PER_CORRECT=1000
REWARD_CONFIRM_DELAY_MS=5000
REWARD_REQUIRE_WALLET=true

{
  "name": "geek-protocol-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=web",
    "dev:api": "turbo dev --filter=api",
    "build": "turbo build",
    "build:web": "turbo build --filter=web",
    "build:api": "turbo build --filter=api",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "lint:economy": "turbo lint:economy",
    "lint:claims": "turbo lint:claims",
    "lint:brand": "turbo lint:brand",
    "verify": "turbo type-check lint:economy lint:claims lint:brand test:unit test",
    "test:unit": "turbo test:unit"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5"
  }
}

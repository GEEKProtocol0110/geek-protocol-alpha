# ==============================================================================
# GEEK PROTOCOL — ENVIRONMENT TEMPLATE  (copy to .env)
# ==============================================================================
# Copy this file to .env and fill in the secrets.
#
# WHAT CHANGED, AND WHY YOUR OLD FILE WAS BROKEN
#
#   JWT_SECRET            → the auth middleware actually reads SECRET_KEY.
#                           Setting only JWT_SECRET meant sessions were signed
#                           with a hardcoded dev default. Renamed below.
#   REDIS_HOST/PORT/PASS  → the code reads a single REDIS_URL. Renamed below.
#   CORS_ORIGIN           → the code reads FRONTEND_ORIGIN. Renamed below.
#   ATTEMPT_TOKEN_SECRET  → attempt tokens are signed with HMAC_SECRET. Removed.
#   KASPA_RPC_URL         → unused. Removed.
#   WALLET_ENCRYPTION_KEY → was missing entirely; custodial wallet encryption
#                           needs it, and it must be EXACTLY 32 bytes.
#
# The API refuses to boot in production if any of these are wrong. Run
# `npm run preflight` in apps/api to check this file before starting.
#
# For production use .env.production.example as the template — NOT this file.
# ==============================================================================


# ------------------------------------------------------------------------------
# CORE INFRASTRUCTURE
# ------------------------------------------------------------------------------

# PostgreSQL. The economy uses Decimal(30,0) columns and Serializable
# transactions, so Postgres 12+ is required.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/geek_protocol"

# Redis — one URL, not host/port/password. Backs BullMQ payout queues, auth
# nonces, write-once quiz answers, the once-per-day reward lock, and the
# economy worker's distributed locks.
REDIS_URL="redis://localhost:6379"

PORT=3002
HOST="0.0.0.0"
NODE_ENV="development"

# Comma-separated browser origins allowed to make credentialed requests.
FRONTEND_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# Optional: a LAN IP to allow in development, for testing on a phone.
LAN_IP=""


# ------------------------------------------------------------------------------
# SECRETS  (development values — regenerate for any shared environment)
# ------------------------------------------------------------------------------
# Regenerate with:  cd apps/api && npm run gen:secrets

# Signs session JWTs and cookies. A leak lets anyone forge an admin session.
SECRET_KEY=""   # generate: cd apps/api && npm run gen:secrets

# Signs quiz attempt tokens, which carry the answer key. A leak lets players
# forge their own scores.
HMAC_SECRET=""  # generate: cd apps/api && npm run gen:secrets

# AES-256 key encrypting custodial wallet private keys.
# MUST BE EXACTLY 32 BYTES. The server will not start otherwise.
WALLET_ENCRYPTION_KEY=""  # EXACTLY 32 bytes — npm run gen:secrets

JWT_EXPIRES_IN="7d"


# ==============================================================================
# ECONOMY  —  see ECONOMY.md
# ==============================================================================

# ------------------------------------------------------------------------------
# ROLLOUT STAGE  (the master safety switch)
# ------------------------------------------------------------------------------
# 1 = internal balances only     4 = external review
# 2 = closed alpha               5 = limited public beta  ← first stage that can
# 3 = small test treasury            enable real money
# 6 = scaling
#
# This is a CEILING. The database config row can never declare a stage higher
# than this value, so a compromised admin account cannot switch on withdrawals
# or purchases by editing a row. Withdrawals and purchases require stage >= 5
# AND their own flag; a flag alone is never sufficient.
ECONOMY_STAGE="1"

# ------------------------------------------------------------------------------
# GENESIS TREASURY FUNDING
# ------------------------------------------------------------------------------
# Applied by:  cd apps/api && npm run economy:seed -- --fund
# Idempotent — running it twice funds once.
#
# These numbers are the protocol's solvency backing. Rewards stop being created
# when liabilities would exceed them, which is the whole insolvency defence:
# the protocol refuses to promise GEEK it does not hold.
#
# Values are in WHOLE GEEK.

# Funds all gameplay rewards (Daily Quiz, Gauntlet). Refilled by the 70% recycle.
ECONOMY_GENESIS_REWARD_RESERVE_GEEK="50000000"

# Funds CCE creator rewards, royalties and reviewer rewards.
ECONOMY_GENESIS_CREATOR_POOL_GEEK="10000000"

# Funds tournament prize pools. Zero while tournaments are disabled.
ECONOMY_GENESIS_TOURNAMENT_POOL_GEEK="0"

# Platform revenue account. Also backs any pre-existing user balances migrated
# from the legacy geekBalance column.
ECONOMY_GENESIS_OPERATIONS_GEEK="5000000"

# Backs outstanding withdrawal obligations. Zero while withdrawals are disabled;
# it must cover in-flight withdrawals before they can be enabled.
ECONOMY_GENESIS_HOT_WALLET_GEEK="0"

# Untouchable buffer. The health endpoint subtracts this from reward capacity,
# so the protocol stops paying before it eats its own reserve.
ECONOMY_GENESIS_EMERGENCY_RESERVE_GEEK="5000000"

# ------------------------------------------------------------------------------
# ECONOMY WORKER
# ------------------------------------------------------------------------------
# Run with:  cd apps/api && npm run dev:economy-worker
# It clears matured pending rewards, evaluates circuit breakers, and publishes
# the heartbeat that trips the ALL breaker when payout processing dies.

# How often to sweep matured pending credits into available balance (ms).
ECONOMY_CLEARING_INTERVAL_MS="60000"

# How often to re-evaluate circuit breaker conditions (ms).
ECONOMY_MONITOR_INTERVAL_MS="300000"

# Heartbeat publish interval (ms). Must be well under the 120s staleness
# threshold in the economy rules, or the ALL breaker will trip on a healthy
# system.
ECONOMY_HEARTBEAT_INTERVAL_MS="30000"

# Pending credits cleared per sweep.
ECONOMY_CLEARING_BATCH="500"


# ------------------------------------------------------------------------------
# REWARDS AND PAYOUTS
# ------------------------------------------------------------------------------

# Master switch for the on-chain payout path. Keep "false" until a real KRC-20
# transfer implementation exists — with it false, the payout worker RELEASES
# withdrawals back to available balance rather than pretending they settled.
ENABLE_REWARDS="false"

# Demo mode grants ZERO GEEK (XP only). It no longer fabricates transaction ids
# or credits balances. Must be false in production; the server refuses to boot
# otherwise, because it also disables wallet signature verification.
DEMO_MODE="false"

MIN_SCORE_FOR_REWARD="70"

# Payout queue sharding. lanes × concurrency = max simultaneous payouts.
PAYOUT_LANES="4"
PAYOUT_CONCURRENCY="5"


# ------------------------------------------------------------------------------
# KASPA / KRC-20
# ------------------------------------------------------------------------------

# mainnet | testnet | devnet | simnet
# Withdrawal addresses are validated against this network's prefix. Sending to
# the wrong network is an unrecoverable loss, so a mismatch is refused.
KASPA_NETWORK="testnet"

# KRC-20 ticker for payouts. Required before ENABLE_REWARDS can be true.
GEEK_TOKEN_TICKER=""

# Transfer provider. "none" means no on-chain transfer is possible — which is
# the honest current state. Production refuses to start with ENABLE_REWARDS
# true and no provider configured.
KASPA_TRANSFER_PROVIDER="none"

# Kasplex indexer, for reading KRC-20 balances.
KASPLEX_API_URL="https://kasplex-testnet.herokuapp.com"

# Treasury wallet private key for outbound payouts.
# LEAVE EMPTY until stage 3+. Never commit a funded key.
TREASURY_PRIVATE_KEY=""

# Approved burn address. Required before a burn batch can be approved.
# Nothing is broadcast at stage 1 — the burn share accrues in BURN_PENDING.
GEEK_BURN_ADDRESS=""


# ------------------------------------------------------------------------------
# STRIPE  (fiat purchases — DISABLED)
# ------------------------------------------------------------------------------
# Purchases require ECONOMY_STAGE >= 5, purchasesEnabled in the config row, and
# legal review. The webhook now verifies the RAW request body and de-duplicates
# by Stripe event id; both were broken before.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""


# ------------------------------------------------------------------------------
# WEB APP
# ------------------------------------------------------------------------------
# The site reads round fees, rewards, timers and CCE rates from the API at
# runtime, so this URL must be reachable from the Next.js server, not only the
# browser. If it is wrong, the homepage shows an honest "unavailable" state
# rather than stale hardcoded numbers.
NEXT_PUBLIC_API_URL="http://localhost:3002"
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# ------------------------------------------------------------------------------
# LOGGING & RATE LIMITING
# ------------------------------------------------------------------------------
LOG_LEVEL="info"
LOG_PRETTY="true"
RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW="900000"


# ==============================================================================
# FIRST-RUN CHECKLIST
# ==============================================================================
#   cd apps/api
#   npm run prisma:generate
#   npm run prisma:push              # or: npm run prisma:migrate
#   npm run economy:seed -- --fund   # treasury, budgets, breakers, config
#   npm run economy:migrate-balances # only if you have existing geekBalance data
#   npm run economy:reconcile        # must exit 0
#   npm run economy:health           # prints the treasury report
#
# Then, in three terminals:
#   npm run dev                 (apps/api)
#   npm run dev:worker          (apps/api — payouts)
#   npm run dev:economy-worker  (apps/api — clearing, breakers, heartbeat)
#   npm run dev                 (apps/web)
# ==============================================================================

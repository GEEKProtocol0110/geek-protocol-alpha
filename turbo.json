{
  "$schema": "https://turbo.build/json-schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**"
      ]
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "type-check": {
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "lint:economy": {
      "outputs": []
    },
    "lint:claims": {
      "outputs": []
    },
    "lint:brand": {
      "outputs": []
    },
    "test:unit": {
      "outputs": []
    }
  }
}

# ══════════════════════════════════════════════════════════════════════════════
# GEEK PROTOCOL — PRODUCTION ENVIRONMENT
#
# Copy to .env (or paste into your host's secret manager), fill every value
# marked REQUIRED, then verify with:
#
#     cd apps/api && NODE_ENV=production npm run preflight
#
# The API refuses to boot if a required secret is missing, left at a default, or
# too weak. That is deliberate: every secret here previously had an inline
# fallback, so a deploy that forgot one started anyway and signed real sessions
# with a value that is public in this repository.
#
# NOTE: .env.example (the old file) documented JWT_SECRET, REDIS_HOST/PORT and
# KASPA_RPC_URL — none of which the running code reads. Use THIS file.
# ══════════════════════════════════════════════════════════════════════════════

NODE_ENV="production"
PORT="5000"


# ─── 1. SECRETS — REQUIRED ────────────────────────────────────────────────────
# Generate all three at once:   cd apps/api && npm run gen:secrets
#
# Never commit these. Never reuse them between staging and production.

# Signs session JWTs and cookies.
# Anyone who obtains this can forge an admin session for any account.
# NOTE: this is SECRET_KEY, not JWT_SECRET. JWT_SECRET is read by nothing.
SECRET_KEY=""

# Signs quiz attempt tokens (which carry the correct answers and the issue time).
# Anyone who obtains this can forge a perfect score and mint payouts.
HMAC_SECRET=""

# AES-256 key encrypting custodial wallet private keys at rest.
# MUST be exactly 32 bytes. Back it up before deploying: if you lose it, every
# custodial wallet becomes permanently unspendable. Do not rotate it while any
# custodial wallet holds funds.
WALLET_ENCRYPTION_KEY=""


# ─── 2. DATA STORES — REQUIRED ────────────────────────────────────────────────
# Use TLS in production: `postgresql://...?sslmode=require` and `rediss://`.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/geekdb?schema=public&sslmode=require"

# Must be Redis 6.2+ — single-use login nonces rely on GETDEL being atomic.
# This is REDIS_URL, one connection string. REDIS_HOST/REDIS_PORT are not read.
REDIS_URL="rediss://default:PASSWORD@HOST:6379"


# ─── 3. ORIGINS — REQUIRED ────────────────────────────────────────────────────
# Comma-separated exact browser origins, scheme included, no trailing slash.
# In production this list is the ENTIRE CORS allow-list. Do not include
# localhost: cookies are sent with credentials, so anything listed here can
# drive an authenticated session.

FRONTEND_ORIGIN="https://geekprotocol.xyz,https://www.geekprotocol.xyz"
FRONTEND_URL="https://geekprotocol.xyz"


# ─── 4. KASPA ─────────────────────────────────────────────────────────────────

# "mainnet" | "testnet-10" | "testnet-11".
# This decides which address prefix (kaspa: / kaspatest:) is generated and
# accepted, so a mismatch here sends payouts to addresses nobody controls.
KASPA_NETWORK="mainnet"

# MUST be "false" in production. When true, wallet signature verification is
# skipped entirely and anyone can authenticate as any wallet address.
# The server refuses to start if this is true while NODE_ENV=production.
DEMO_MODE="false"


# ─── 5. PAYOUTS ───────────────────────────────────────────────────────────────
#
# READ THIS BEFORE SETTING ENABLE_REWARDS="true".
#
# On-chain KRC-20 transfer is NOT implemented. KRC-20 is inscription-based and
# needs a commit/reveal transaction pair signed against a funded treasury; that
# code does not exist in this repo yet (see apps/api/src/lib/kaspa.ts).
#
# With ENABLE_REWARDS="false", GEEK balances are credited in the database and
# nothing touches the chain. That is the correct setting today.
#
# With "true", every payout will THROW and land in the failed queue rather than
# silently pretending to succeed. Earlier code returned a fabricated txid here,
# which wrote fake transaction ids into the ledger as though they had settled.

ENABLE_REWARDS="false"

# Required only when ENABLE_REWARDS="true".
# "none" (default) | "kasplex"
KASPA_TRANSFER_PROVIDER="none"

# The real deployed KRC-20 ticker. The code previously hardcoded the string
# "GEEK" with a "replace with actual token ID" note — set the true value here.
GEEK_TOKEN_TICKER=""

# Treasury key that funds reward payouts. Hold this in a secret manager, never
# in a file. Fund it only with what you can afford to have online.
TREASURY_PRIVATE_KEY=""

KASPLEX_API_URL="https://api.kasplex.org"

# Payout throughput = PAYOUT_LANES × PAYOUT_CONCURRENCY simultaneous transfers.
# Defaults give 200. Raise lanes for more parallelism; keep concurrency within
# what your Kaspa node and treasury UTXO set can sustain.
PAYOUT_LANES="8"
PAYOUT_CONCURRENCY="25"


# ─── 6. GAMEPLAY & ANTI-ABUSE (optional — sane defaults shown) ────────────────

# Creator Content Engine gating.
CCE_MIN_LEVEL="10"              # level required to submit or review
CCE_MIN_WINS="5"                # real quiz wins required before voting
CCE_WIN_MIN_CORRECT="7"         # correct answers that make an attempt a "win"
CCE_DAILY_REVIEW_CAP="30"       # reviews per account per UTC day
CCE_MIN_ACCOUNT_AGE_HOURS="72"  # account age before voting is allowed
CCE_MAX_PER_CREATOR_WEEK="3"    # reviews of one author per reviewer per week
CCE_APPROVAL_THRESHOLD="5"      # approvals needed to publish
CCE_REJECTION_THRESHOLD="3"     # rejections needed to kill
CCE_ACCURACY_GRACE_REVIEWS="20" # resolved reviews before accuracy is enforced
CCE_MIN_ACCURACY_PCT="40"       # consensus agreement floor
CCE_MIN_REVIEW_SECONDS="5"      # minimum time on a question before voting


# ─── 7. PAYMENTS (optional — only if selling GEEK for fiat) ───────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""


# ─── 8. FRONTEND (set in your Vercel project, not here) ───────────────────────
# NEXT_PUBLIC_API_URL="https://api.geekprotocol.xyz"


# ─── 9. ECONOMY ───────────────────────────────────────────────────────────────
# Full rules: ECONOMY.md
#
# ROLLOUT STAGE — the master safety switch.
#   1 internal balances only   2 closed alpha        3 small test treasury
#   4 external review          5 limited public beta 6 scaling
#
# This is a CEILING on the stage the database config row may declare, so a
# compromised admin account cannot enable real money by editing a row.
# Withdrawals and fiat purchases require stage >= 5 AND their own flag.
# Do not raise this past 1 until the KRC-20 transfer path is implemented,
# reconciliation has been green for a sustained period, and an external audit
# has been completed.
ECONOMY_STAGE="1"

# Genesis treasury funding, in WHOLE GEEK. Applied once by:
#     cd apps/api && npm run economy:seed -- --fund
#
# This is the protocol's solvency backing. Rewards STOP rather than being
# created unfunded when liabilities would exceed it. Set these deliberately:
# they are the ceiling on everything the protocol can ever owe its users.
ECONOMY_GENESIS_REWARD_RESERVE_GEEK=""
ECONOMY_GENESIS_CREATOR_POOL_GEEK=""
ECONOMY_GENESIS_TOURNAMENT_POOL_GEEK="0"
ECONOMY_GENESIS_OPERATIONS_GEEK=""
# Must cover outstanding withdrawal obligations before withdrawals are enabled.
ECONOMY_GENESIS_HOT_WALLET_GEEK="0"
# Untouchable buffer, subtracted from reward capacity.
ECONOMY_GENESIS_EMERGENCY_RESERVE_GEEK=""

# Economy worker cadence. The heartbeat interval must stay well under the 120s
# staleness threshold, or the ALL circuit breaker trips on a healthy system.
ECONOMY_CLEARING_INTERVAL_MS="60000"
ECONOMY_MONITOR_INTERVAL_MS="300000"
ECONOMY_HEARTBEAT_INTERVAL_MS="30000"
ECONOMY_CLEARING_BATCH="500"

# Approved burn address. Required before a burn batch can be approved.
# A burn is NEVER recorded as confirmed without a real on-chain reveal txid.
GEEK_BURN_ADDRESS=""


# ══════════════════════════════════════════════════════════════════════════════
# DEPLOY CHECKLIST
#
#   1. cd apps/api && npm run gen:secrets      → paste the three secrets above
#   2. Back up WALLET_ENCRYPTION_KEY somewhere you cannot lose it
#   3. npx prisma migrate deploy               → apply schema
#   4. NODE_ENV=production npm run preflight   → must print "Preflight passed"
#   5. Start BOTH processes:
#         web:    cd apps/api && npm run start
#         worker: cd apps/api && npm run worker
#      The API only enqueues payouts. Without the worker, nobody is ever paid.
#   6. cd apps/api && npm run economy:seed -- --fund
#         → creates treasury accounts, budgets, circuit breakers, config row
#   7. npm run economy:migrate-balances   (only if legacy geekBalance data exists)
#   8. npm run economy:reconcile          → MUST exit 0 before taking traffic
#   9. Start the economy worker too:
#         economy: cd apps/api && npm run start:economy-worker
#      Without it, pending rewards never clear and no breaker ever trips.
#  10. Watch /health/payouts — a rising totalWaiting means the payout worker is down.
#  11. Watch /api/economy/health — solvencyRatio, remainingRewardCapacity,
#      and any tripped circuit breakers.
#  12. Schedule `npm run economy:reconcile` hourly. A non-zero exit means the
#      ledger and the stored balances disagree: stop and investigate.
# ══════════════════════════════════════════════════════════════════════════════
